# SkillProof Backend - Environment Variables

# Groq AI
GROQ_API_KEY=your_groq_api_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# GitHub
GITHUB_TOKEN=your_github_personal_access_token_here

# App Settings
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Evidence Engine Thresholds (configurable)
EVIDENCE_PROVEN_THRESHOLD=80
EVIDENCE_PARTIAL_THRESHOLD=40

# Scoring Weights
WEIGHT_LANGUAGE_USAGE=25
WEIGHT_DEPENDENCY=20
WEIGHT_CODE_PATTERNS=20
WEIGHT_TESTS=15
WEIGHT_README=5
WEIGHT_COMMITS=10
WEIGHT_DEPLOYMENT=5
